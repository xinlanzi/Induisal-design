        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% 初始化阶段\n    Start([硬件上电 S1开关打开]) --&gt; Power_Dist[升压模块工作: 5V供Nano/传感器, 12V供电机驱动VM]\n    Power_Dist --&gt; Setup_Init[执行 Setup() 初始化]\n    Setup_Init --&gt; Init_Actuators[初始化引脚: 舵机D9归中90度, 电机D2/D3/D5输出低电平]\n    Init_Actuators --&gt; Init_MPU[初始化 MPU6050 DMP (I2C接口 A4/A5)]\n    Init_MPU --&gt; MPU_Check{DMP初始化成功?}\n    \n    MPU_Check -- 否, 错误码 --&gt; Halt[死循环停机 while(1)]\n    MPU_Check -- 是 --&gt; Calibrate[静止校准: 陀螺仪与加速度计]\n    Calibrate --&gt; SetTime[启用DMP, 记录启动时间 startTime]\n\n    SetTime --&gt; Loop_Start((进入主循环 Loop))\n\n    %% 循环控制\n    Loop_Start --&gt; Active_Check{systemActive &lt;br&gt;系统活跃?}\n    Active_Check -- 否 --&gt; Loop_End([直接结束本次循环])\n    Active_Check -- 是 --&gt; Time_Calc[计算运行时长 elapsedTime]\n\n    %% 数据采集阶段\n    Time_Calc --&gt; DMP_Read{DMP中断/数据包就绪?}\n    DMP_Read -- 是 --&gt; Calc_Yaw[读取FIFO缓冲, 解算四元数与欧拉角&lt;br&gt;更新当前偏航角 rawYaw]\n    DMP_Read -- 否 --&gt; Skip_Read\n    Calc_Yaw --&gt; Skip_Read[计算相对角度 yawAngle = rawYaw - yawOffset]\n\n    %% 状态机核心控制逻辑\n    Skip_Read --&gt; State_Machine{判断运行时长 elapsedTime}\n\n    %% 阶段 1：等待\n    State_Machine -- \&quot;0 ~ 1秒 (等待期)\&quot; --&gt; Wait_Stage[静止等待, 无操作]\n\n    %% 阶段 2：加速\n    State_Machine -- \&quot;1秒 ~ 3秒 (加速期)\&quot; --&gt; Motor_Start_Check{电机初次启动?}\n    Motor_Start_Check -- 是 --&gt; Motor_Init_Start[记录起始偏航基准 yawOffset&lt;br&gt;标记 motorStarted=true&lt;br&gt;开启TB6612正转(AIN1=H, AIN2=L)]\n    Motor_Start_Check -- 否 --&gt; PWM_Accel\n    Motor_Init_Start --&gt; PWM_Accel[计算进度比例&lt;br&gt;PWM线性加速 50 -&gt; 250 (PWMA引脚)]\n\n    %% 阶段 3：巡航修正\n    State_Machine -- \&quot;3秒 ~ 20秒 (巡航期)\&quot; --&gt; PWM_Cruise[根据偏航角大小计算降速衰减量 speedDecay&lt;br&gt;动态调整PWM维持行驶 (最低120)]\n\n    %% 阶段 4：停机\n    State_Machine -- \&quot;&gt; 20秒 (停机期)\&quot; --&gt; System_Stop[关闭TB6612电机输出 (引脚置低)&lt;br&gt;设置 systemActive = false]\n\n    %% 汇聚与舵机控制\n    Wait_Stage --&gt; Servo_Check\n    PWM_Accel --&gt; Servo_Check\n    PWM_Cruise --&gt; Servo_Check\n    System_Stop --&gt; Loop_End\n\n    %% 独立于电机的舵机修正系统\n    Servo_Check{电机已启动?&lt;br&gt;且运行时长 &lt; 20秒}\n    Servo_Check -- 是 --&gt; Servo_Update[根据 PID 比例计算目标角度:&lt;br&gt;targetAngle = 90 + yawAngle * Kp&lt;br&gt;驱动小舵机 D9]\n    Servo_Check -- 否 --&gt; Loop_End\n\n    Servo_Update --&gt; Loop_End\n    Loop_End -. 重新循环 .-&gt; Loop_Start\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mros-8F7yw-eaFC324OK-1">
