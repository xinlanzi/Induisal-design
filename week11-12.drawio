        <mxCell id="9HsNX1XX4FbqHM6ew_-I-28" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;br class=&quot;Apple-interchange-newline&quot;&gt;&lt;table data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;,&amp;quot;background-color&amp;quot;:&amp;quot;rgb(236, 236, 236)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-align: left; background-color: light-dark(rgb(236, 236, 236), rgb(34, 34, 34)); border-collapse: collapse;&quot;&gt;&lt;tbody style=&quot;forced-color-adjust: none;&quot;&gt;&lt;tr height=&quot;27&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-weight: bold; text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;对比维度&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-weight: bold; text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;Surface Modeling（参数化曲面）&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-weight: bold; text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;Surface Mesh Modeling（网格曲面）&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;27&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;数学表示方式&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;连续（NURBS 非均匀有理 B 样条）&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;离散（三角形 / 四边形面片）&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;27&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;核心编辑单元&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;控制点与权重&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;顶点与面&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;27&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;数学精度&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;数学上绝对精确，可无限缩放无锯齿&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;精度由面片数量决定，面片越少锯齿越明显&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;27&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;拓扑结构&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;拓扑结构严格，曲面边界必须连续，不支持非流形边&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;拓扑结构极度灵活，支持任意形状、孔洞、重叠面及非流形结构&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;27&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;修改灵活性&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;历史参数驱动，可随时回溯修改早期步骤，适合多轮迭代设计&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;无参数化历史记录，修改需直接操作顶点，复杂模型修改成本极高&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;27&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;布尔运算稳定性&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;稳定性差，复杂曲面布尔运算易出现破面、失败&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;稳定性极高，几乎所有布尔运算都能完成&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;27&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;文件体积特性&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;文件体积小，仅存储参数方程与控制点信息&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;文件体积大，需存储所有顶点、面及法线数据，精度提升呈指数级增大&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;27&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;计算负载特性&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;计算密集，需实时求解复杂参数方程&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;计算简单，仅需直接渲染三角面片&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;27&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;渲染性能&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;实时渲染性能差，需先网格化转换&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;原生支持实时渲染，是游戏、影视的标准渲染格式&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;46&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&quot; style=&quot;forced-color-adjust: none; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: left; overflow-wrap: break-word; word-break: break-word; white-space: pre-wrap;&quot;&gt;工业可制造性&lt;/td&gt;&lt;td data-mx-given-colors=&quot;{&amp;quot;color&amp;quot;:&amp;quot;rgb(0, 0, 0)&amp;quot;}&