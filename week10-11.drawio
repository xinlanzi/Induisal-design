<mxfile host="app.diagrams.net">
  <diagram name="第 1 页" id="2mJU2IG9U6x51s-JhC24">
    <mxGraphModel dx="792" dy="429" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="y8sksL_P7bWzY2dNYQ7S-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;dashed=1;dashPattern=8 4 1 4;" value="" vertex="1">
          <mxGeometry height="235" width="350" x="260" y="155" as="geometry" />
        </mxCell>
        <mxCell id="y8sksL_P7bWzY2dNYQ7S-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;b&gt;测试系统的三类问题&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="220" x="350" y="140" as="geometry" />
        </mxCell>
        <mxCell id="y8sksL_P7bWzY2dNYQ7S-3" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;ul style=&quot;list-style-type: disc;&quot;&gt;&lt;li&gt;&lt;b&gt;已知输入、输出，求仪器本身特性：系统辨识&lt;/b&gt;&lt;/li&gt;&lt;li&gt;已知仪器特性、仪器读数，反推真实物理输入：输入反求&lt;/li&gt;&lt;li&gt;已知真实输入 + 仪器特性，预判仪器输出读数：输出预测&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="90" width="520" x="240" y="180" as="geometry" />
        </mxCell>
        <mxCell id="y8sksL_P7bWzY2dNYQ7S-4" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;两大核心特性&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="110" x="380" y="252.5" as="geometry" />
        </mxCell>
        <mxCell id="y8sksL_P7bWzY2dNYQ7S-5" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;ul style=&quot;list-style-type: disc;&quot;&gt;&lt;li&gt;✅&lt;strong&gt;静态特性：被测信号不随时间变化&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;灵敏度、非线性度、漂移、回程误差、精度、引用误差。&lt;/li&gt;&lt;li&gt;⏱️&lt;strong&gt;动态特性：被测信号随时间不停变化（振动、波动温度）&lt;/strong&gt;。&lt;/li&gt;&lt;li&gt;仪器有惯性、储能元件（电容、质量、弹簧、热容），跟不上变化，要用微分方程描述。&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="110" width="370" x="240" y="270" as="geometry" />
        </mxCell>
        <mxCell id="y8sksL_P7bWzY2dNYQ7S-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;dashPattern=8 4 1 4;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="170" width="390" x="640" y="155" as="geometry" />
        </mxCell>
        <mxCell id="y8sksL_P7bWzY2dNYQ7S-6" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;线性系统的定义与五大性质&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="260" x="720" y="160" as="geometry" />
        </mxCell>
        <mxCell id="y8sksL_P7bWzY2dNYQ7S-9" parent="1" style="text;whiteSpace=wrap;html=1;" value="绝大多数传感器在量程范围内，近似&lt;strong&gt;线性时不变系统 LTI&lt;/strong&gt;" vertex="1">
          <mxGeometry height="40" width="330" x="650" y="195" as="geometry" />
        </mxCell>
        <mxCell id="y8sksL_P7bWzY2dNYQ7S-10" parent="1" style="text;whiteSpace=wrap;html=1;strokeWidth=2;" value="&lt;ol style=&quot;list-style-type: decimal;&quot;&gt;&lt;li&gt;&lt;strong&gt;叠加性&lt;/strong&gt;：多个信号一起输入，输出等于各个单独输出相加。&lt;/li&gt;&lt;li&gt;&lt;strong&gt;齐次性（比例）&lt;/strong&gt;：输入放大 k 倍，输出同步放大 k 倍。&lt;/li&gt;&lt;li&gt;&lt;strong&gt;微分特性&lt;/strong&gt;：输入求导，输出也对应求导。&lt;/li&gt;&lt;li&gt;&lt;strong&gt;积分特性&lt;/strong&gt;：零初始条件，输入积分，输出同步积分。&lt;/li&gt;&lt;li&gt;✨&lt;strong&gt;频率保持性：&lt;/strong&gt;不产生新的频率成分，只改变幅值大小和相位。&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="130" width="390" x="630" y="212.5" as="geometry" />
        </mxCell>
        <mxCell id="y8sksL_P7bWzY2dNYQ7S-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=8 4 1 4;" value="" vertex="1">
          <mxGeometry height="752" width="350" x="258" y="425" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;静态特性指标&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="110" x="380" y="430" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="标定：给传感器&lt;strong&gt;已知标准输入 X&lt;/strong&gt;，记录输出 Y，拟合曲线。" vertex="1">
          <mxGeometry height="40" width="380" x="270" y="470" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-3" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DDECFF;strokeColor=#6c8ebf;shadow=1;" value="" vertex="1">
          <mxGeometry height="80" width="310" x="280" y="500" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-5" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3&gt;①灵敏度 S&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;：输入变化&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;Δ&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;&amp;nbsp;x&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;，输出变化&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;Δ&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;&amp;nbsp;y&lt;/span&gt;&lt;/h3&gt;&lt;h3&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;求斜率:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;S =&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;Δ&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt; y /&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;Δ&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;&amp;nbsp;x&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="70" width="300" x="290" y="496" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-7" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DDECFF;strokeColor=#6c8ebf;shadow=1;" value="" vertex="1">
          <mxGeometry height="178" width="310" x="280" y="592" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-6" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3&gt;②非线性度（非线性误差）&lt;/h3&gt;&lt;p&gt;偏离拟合直线多少:&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;\(\text{非线性度}= \frac{B}{A}\times100\%\)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;A：满量程；B：标定曲线与拟合直线间&lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;最大偏差&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;两种拟合参考直线：&amp;nbsp;&lt;/p&gt;&lt;p&gt;1）端基直线：直接连接标定曲线起点、终点；&amp;nbsp;&lt;/p&gt;&lt;p&gt;2）独立（最小二乘）：误差平方最小的最优拟合线。&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="290" x="290" y="585" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-9" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DDECFF;strokeColor=#6c8ebf;shadow=1;" value="" vertex="1">
          <mxGeometry height="130" width="310" x="280" y="784" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-8" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3&gt;③漂移 Drift&lt;/h3&gt;&lt;h3&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;零漂：输入等于 0 的时候发生的漂移&lt;/span&gt;&lt;/h3&gt;&lt;h3&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;点漂：任意恒定输入下输出随时间漂移&lt;/span&gt;&lt;/h3&gt;&lt;h3&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-size: 12px; font-weight: normal;&quot;&gt;灵敏度漂移：曲线斜率发生变化（温度、元器件老化）&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="152" width="300" x="290" y="777" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-12" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DDECFF;strokeColor=#6c8ebf;shadow=1;" value="" vertex="1">
          <mxGeometry height="137.64" width="310" x="280" y="923.36" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-10" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3&gt;④回程误差（迟滞）&lt;/h3&gt;&lt;p&gt;输入从小到大上升；再从大到小下降，&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;同一个输入 X，得到两个不一样输出 Y&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;。&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;（齿轮间隙、材料弹性滞后、磁滞)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;\(回程误差=\frac{h_{max}}{A}\)&lt;br&gt;\(h_{max}\)：同一输入，上升下降输出极差；A 满量程。&lt;/p&gt;" vertex="1">
          <mxGeometry height="208.71" width="290" x="290" y="908" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-14" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DDECFF;strokeColor=#6c8ebf;rounded=1;roundedPerimeter=1;glass=0;multiple=0;shadow=1;" value="" vertex="1">
          <mxGeometry height="93" width="310" x="278" y="1067" as="geometry" />
        </mxCell>
        <mxCell id="oaAtDDPTm3okgFsRBYkK-13" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3&gt;⑤精度、引用误差（精度等级）&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;引用误差&lt;/strong&gt;：最大绝对误差 ÷ 满量程 FS&lt;/p&gt;&lt;p&gt;精度等级就是最大允许引用误差。&lt;/p&gt;" vertex="1">
          <mxGeometry height="108" width="232.55" x="291" y="1058" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
