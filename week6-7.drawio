          <mxGeometry height="121" width="470" x="270" y="769" as="geometry" />
        </mxCell>
        <mxCell id="L6gN1ls24-3lZonujxX8-31" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;div class=&quot;ace-line ace-line old-record-id-VfYWdIMMhoqsW7xYCxsco9fcnom&quot;&gt;&lt;strong&gt;三角函数的正交性：&lt;/strong&gt;&lt;/div&gt;&lt;ol start=&quot;1&quot; class=&quot;list-number1&quot;&gt;&lt;li class=&quot;ace-line ace-line old-record-id-H4eddP07CodmHZxAL3ycfpIcnlh&quot;&gt;&lt;div&gt;奇函数*偶函数的积分=0&lt;/div&gt;&lt;/li&gt;&lt;li class=&quot;ace-line ace-line old-record-id-ZnjRdzejvo4jxIxlAQ6c4mYhn7b&quot;&gt;&lt;div&gt;奇函数^2或者偶函数^2的积分，n=k时积分=Π，其他情况下积分=0&lt;/div&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;span class=&quot;lark-record-clipboard&quot;&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="89" width="418" x="280.00277108433744" y="774.99578313253" as="geometry" />
        </mxCell>
        <mxCell id="L6gN1ls24-3lZonujxX8-32" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
