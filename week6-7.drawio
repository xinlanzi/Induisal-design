        <mxCell id="L6gN1ls24-3lZonujxX8-11" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;div class=&quot;old-record-id-HLo4dm27YohchpxV72vcjjX5ntV&quot;&gt;信号功率与噪声功率之比&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lark-record-clipboard&quot;&gt;&lt;/span&gt;" vertex="1">
