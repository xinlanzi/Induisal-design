        <mxCell id="AAquhXdZq-wKz_OYIqj0-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4 1 4;strokeWidth=2;" value="" vertex="1">
