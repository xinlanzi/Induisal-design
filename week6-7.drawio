        <mxCell id="AAquhXdZq-wKz_OYIqj0-7" parent="1" style="text;whiteSpace=wrap;fontStyle=1;fontSize=18;" value="窗函数" vertex="1">
          <mxGeometry height="40" width="63" x="473.5" y="1067" as="geometry" />
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-9" parent="1" style="text;whiteSpace=wrap;html=1;" value="时间窗口：截取\([-T/2, T/2]\)这一段信号做分析，窗口外面全部置 0。" vertex="1">
          <mxGeometry height="39.515625" width="458.71875" x="273.64" y="1096.0033333333336" as="geometry" />
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-10" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3&gt;时域相乘 ⇔ 频域卷积（傅里叶变换重要性质）&lt;/h3&gt;&lt;blockquote&gt;&lt;p&gt;\(x(t)\cdot w(t) \stackrel{FT}{\longleftrightarrow} X(f) * W(f)\)&lt;/p&gt;&lt;/blockquote&gt;&lt;ul style=&quot;list-style-type: disc;&quot;&gt;&lt;li&gt;时域：信号直接乘窗函数（截断）&lt;/li&gt;&lt;li&gt;频域：原始信号频谱 和 窗函数的频谱\(W(f)\)做卷积。卷积 = 提取局部模式&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;矩形窗的频谱是\(\boldsymbol{sinc}\)函数，有一个高高的&lt;strong&gt;主瓣&lt;/strong&gt;，两边还有很多&lt;strong&gt;旁瓣&lt;/strong&gt;。&lt;/p&gt;" vertex="1">
          <mxGeometry height="145" width="449.99" x="280" y="1107" as="geometry" />
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-11" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p&gt;&lt;strong&gt;频谱泄露（能量泄露）&lt;/strong&gt;&lt;br&gt;本来某一个频率的能量，应该全部集中在这一根谱线上；加窗截断之后，因为 sinc 的旁瓣，能量扩散到旁边一堆频率上，就叫频谱泄露。（也就是频谱过滤并不干净）&lt;/p&gt;" vertex="1">
          <mxGeometry height="75" width="449.99" x="286" y="1239" as="geometry" />
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-12" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="112.52" width="103.17" x="644" y="1084" as="geometry" />
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-21" edge="1" parent="1" source="AAquhXdZq-wKz_OYIqj0-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;" target="AAquhXdZq-wKz_OYIqj0-6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="781.9" y="1213" />
              <mxPoint x="781.9" y="1254.1" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=8 4 1 4;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="212" width="410" x="780" y="1107" as="geometry" />
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-13" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;div class=&quot;ace-line ace-line old-record-id-Ex8rdn64LoRaqfxqnVhcK0nmnJc&quot;&gt;扫频：用不同频率组分来确定发生共振的频率，从控制上怎么解决共振问题？&lt;/div&gt;&lt;/div&gt;&lt;span class=&quot;lark-record-clipboard&quot;&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="36" width="448" x="783" y="1142" as="geometry" />
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-15" parent="1" style="text;whiteSpace=wrap;fontStyle=1;fontSize=18;" value="整形器" vertex="1">
          <mxGeometry height="40" width="63" x="953" y="1111" as="geometry" />
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-16" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="71" width="253.57" x="789" y="1169" as="geometry" />
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-17" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="71" width="137.91" x="1042.57" y="1169" as="geometry" />
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-18" parent="1" style="text;whiteSpace=wrap;html=1;" value="一小串、带延时、带比例系数的脉冲，通过原始指令 和 整形脉冲序列 做【时域卷积】" vertex="1">
          <mxGeometry height="36" width="394" x="789" y="1244" as="geometry" />
        </mxCell>
        <mxCell id="AAquhXdZq-wKz_OYIqj0-19" parent="1" style="text;whiteSpace=wrap;html=1;" value="它不是滤波器，是&lt;strong&gt;提前修改给出去的运动命令，&lt;/strong&gt;所以必然产生指令延时" vertex="1">
          <mxGeometry height="36" width="380" x="794.5" y="1280" as="geometry" />
        </mxCell>
      </root>
